APP_NAME="Artel Agent Server"
APP_VERSION="0.1.0"
APP_ENV="local"

# Root logger level, applied at startup by app/logging_config.py.
LOG_LEVEL="INFO"

# Chat credentials. LLM_* is the current name; OPENROUTER_* is still read for
# backward compatibility and loses to LLM_* when both are set. The base URL may
# point at OpenRouter or at any gateway serving several providers, which is why
# the name carries no provider.
LLM_API_KEY="replace-with-your-llm-api-key"
LLM_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_TITLE="Artel Agent Server"

# Per-request ceiling on one model call, and how many times the client retries.
# The difference between a slow answer and no answer, not a tuning knob.
OPENROUTER_TIMEOUT_SECONDS="180.0"
OPENROUTER_MAX_RETRIES="1"

# AWS Bedrock. A model value starting with `bedrock/` goes here instead of to
# LLM_BASE_URL. BEDROCK_API_KEY is optional — unset, the standard AWS credential
# chain answers. It is read here rather than as AWS_BEARER_TOKEN_BEDROCK because
# `.env` fills Settings only and never reaches the environment boto3 reads.
BEDROCK_REGION="us-west-2"
BEDROCK_API_KEY=""
BEDROCK_TIMEOUT_SECONDS="120.0"
BEDROCK_MAX_ATTEMPTS="3"

# LangSmith tracing. Leave LANGSMITH_TRACING false to run without traces.
# LANGSMITH_PROJECT defaults to artel-agent-server-<APP_ENV> when empty.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_PROJECT=""

# Required. `lifespan` opens this connection unconditionally at startup, and
# both the scenario session store and the QA session store live behind it.
REDIS_URL="redis://localhost:6379/0"
SESSION_TTL_SECONDS="3600"
HISTORY_MAX_TURNS="100000"

# Default prompt version per agent, naming a directory under
# app/prompts/<agent>/. Leave empty to use the newest version present.
# A value naming a directory that does not exist fails at startup.
QA_PROMPT_VERSION=""
QA_COMPACTION_PROMPT_VERSION=""
SCENARIO_PROMPT_VERSION=""
GAME_CONTEXT_PROMPT_VERSION=""
KNOWLEDGE_QUERY_PROMPT_VERSION=""
SCREEN_VERDICT_PROMPT_VERSION=""

# Compaction of the QA run's conversation. ENABLED is a kill switch, not a
# feature flag — a run that breaks on compaction has to be recoverable without a
# deploy. TRIGGER_FRACTION is measured against the model's max_input_tokens.
# MODEL empty means the run's own model; a value outside the catalog in
# app/llm/models.py fails at startup.
QA_COMPACTION_ENABLED="true"
QA_COMPACTION_TRIGGER_FRACTION="0.9"
QA_COMPACTION_KEEP_MESSAGES="20"
QA_COMPACTION_MIN_NEW_MESSAGES="4"
QA_COMPACTION_TRIM_TOKENS="8000"
QA_COMPACTION_MODEL=""

# Stamped onto every `test-case.v1` record. Spec discovery calls no model today,
# so both stay empty unless an operator sets them.
SPEC_PROMPT_VERSION=""
SPEC_MODEL=""

# Embedding model (an OpenRouter slug) and the vector width asked of it.
# EMBEDDING_DIMENSIONS is pinned into Orchestration's vector(N) column, so
# changing either value requires a migration and a full re-index.
EMBEDDING_MODEL="openai/text-embedding-3-large"
EMBEDDING_DIMENSIONS="1024"
EMBEDDING_BATCH_LIMIT="100000"

# Embeddings may authenticate separately from chat, so chat can move gateway
# while the embedding model stays on the provider that owns its vector space.
# Empty means both fall back to the chat credentials above.
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""

# Knowledge items per /knowledge-queries call (one model call each).
KNOWLEDGE_QUERY_BATCH_LIMIT="100000"

# Where per-call LLM token/cost records are shipped. Leave empty to collect
# nothing — that is what a local run wants. A batch leaves on whichever of the
# two bounds comes first; MAX_BUFFER caps what is held while the endpoint is
# unreachable, and the oldest go first past it.
ORCHESTRATION_BASE_URL=""
LLM_USAGE_FLUSH_SIZE="20"
LLM_USAGE_FLUSH_INTERVAL_SECONDS="5.0"
LLM_USAGE_MAX_BUFFER="1000000"

# /extract source fetch guards. EXTRACT_ALLOWED_HOSTS empty means no host
# restriction, which relies on the caller passing presigned URLs.
EXTRACT_MAX_BYTES="2147483648"
EXTRACT_TIMEOUT_SECONDS="3600.0"
EXTRACT_ALLOWED_HOSTS="[]"

# What build this is, injected by the image build (see Dockerfile, Jenkinsfile).
# Unset locally, and a QA run reports them as null rather than guessing.
GIT_SHA=""
IMAGE_TAG=""

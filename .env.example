APP_NAME="Artel Agent Server"
APP_VERSION="0.1.0"
APP_ENV="local"

OPENROUTER_API_KEY="replace-with-your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_TITLE="Artel Agent Server"

# Which backend every chat model call goes to. Only `openrouter` and
# `claude_subscription` are accepted; leaving the value empty is a startup error, so
# delete the line rather than blanking it to get the `openrouter` default.
#
# `claude_subscription` reuses the `claude` CLI credentials on this machine instead of an
# API key, and spends the developer's own Claude plan (monthly credit, five-hour
# rate-limit window). It needs the dev extra: `python -m pip install -e ".[dev]"`.
# It is a local path only — set in a deployed environment it would put server traffic on
# one person's personal rate limit.
LLM_BACKEND="openrouter"

# The Claude model substituted when a call asks for a model that is not an Anthropic slug.
# Under `claude_subscription` this is the common path, not an edge case: DEFAULT_MODEL is
# `openai/gpt-5.6-luna`, which no Claude subscription can serve. Every substitution is
# logged, because a silent swap leaves no way to tell which model answered.
# Ignored entirely while LLM_BACKEND is `openrouter`.
CLAUDE_SUBSCRIPTION_FALLBACK_MODEL="claude-sonnet-5"

# LangSmith tracing. Leave LANGSMITH_TRACING false to run without traces.
# LANGSMITH_PROJECT defaults to artel-agent-server-<APP_ENV> when empty.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_PROJECT=""

# Default prompt version per agent, naming a directory under
# app/prompts/<agent>/. Leave empty to use the newest version present.
QA_PROMPT_VERSION=""
SCENARIO_PROMPT_VERSION=""
GAME_CONTEXT_PROMPT_VERSION=""
KNOWLEDGE_QUERY_PROMPT_VERSION=""

# Embedding model (an OpenRouter slug) and the vector width asked of it.
# EMBEDDING_DIMENSIONS is pinned into Orchestration's vector(N) column, so
# changing either value requires a migration and a full re-index.
EMBEDDING_MODEL="openai/text-embedding-3-large"
EMBEDDING_DIMENSIONS="1024"
EMBEDDING_BATCH_LIMIT="100000"

# Knowledge items per /knowledge-queries call (one model call each).
KNOWLEDGE_QUERY_BATCH_LIMIT="100000"

# Where per-call LLM token/cost records are shipped. Leave empty to collect
# nothing — that is what a local run wants. A batch leaves on whichever of the
# two bounds comes first; MAX_BUFFER caps what is held while the endpoint is
# unreachable, and the oldest go first past it.
ORCHESTRATION_BASE_URL=""
LLM_USAGE_FLUSH_SIZE="20"
LLM_USAGE_FLUSH_INTERVAL_SECONDS="5.0"
LLM_USAGE_MAX_BUFFER="1000000"

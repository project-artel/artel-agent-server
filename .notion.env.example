# Copy this file to .notion.env and fill in your own values.
# .notion.env is gitignored. Never commit it.
#
# Issue an integration token at:
#   https://www.notion.so/profile/integrations
#
# The integration must be connected to each page it reads, otherwise the API
# returns 404 for pages that exist. Open the page, then: ... > Connections.

NOTION_WORKSPACE_ID=
NOTION_API_TOKEN=
